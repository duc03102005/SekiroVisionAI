{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/duc03102005/SekiroVisionAI/blob/feature/temporal-ai-pipeline/Dataset/annotation.schema.json",
  "title": "SekiroVisionAI temporal annotation v2",
  "description": "Source-frame temporal annotations. Semantic validation in DatasetTools.annotation.contract is also required; a schema alone cannot enforce contact evidence, phase order, or original PTS.",
  "type": "object",
  "required": ["schema_version", "annotation_id", "source_id", "source_group_id", "clip_id", "event_id", "strike_id", "boss", "clip_start", "clip_end", "anchor_frame", "state", "movement", "phase", "attack_type", "scope", "impact_evidence", "confidence", "annotation_status", "revision", "example_only"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "annotation_id": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "clip_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "strike_id": {"type": "string", "minLength": 1},
    "boss": {"type": "string", "minLength": 1},
    "boss_phase": {"type": "string"},
    "boss_attack_name": {"type": "string"},
    "clip_start": {"type": "integer", "minimum": 0},
    "clip_end": {"type": "integer", "minimum": 1},
    "anchor_frame": {"type": "integer", "minimum": 0},
    "fps_num": {"type": "integer", "minimum": 1},
    "fps_den": {"type": "integer", "minimum": 1},
    "state": {"enum": ["NON_THREAT", "IDLE", "WALK", "RUN", "TURN", "ATTACK_WINDUP", "ACTIVE_ATTACK", "RECOVERY", "COMBO_CONTINUATION", "FEINT"]},
    "movement": {"enum": ["IDLE", "WALK", "RUN", "TURN", "FEINT", "UNKNOWN_MOVEMENT"]},
    "phase": {"enum": ["ATTACK_WINDUP", "ACTIVE_ATTACK", "RECOVERY", "COMBO_CONTINUATION", "UNKNOWN_PHASE"]},
    "attack_type": {"enum": ["HORIZONTAL_SLASH", "VERTICAL_SLASH", "DIAGONAL_SLASH", "THRUST", "SWEEP", "GRAB", "JUMP_ATTACK", "OVERHEAD_ATTACK", "SPIN_ATTACK", "PROJECTILE", "CHARGE", "AOE", "MULTI_HIT_COMBO", "UNKNOWN_ATTACK"]},
    "scope": {"enum": ["EVENT", "ENTIRE_CLIP_NON_THREAT"]},
    "negative_reason": {"type": ["string", "null"]},
    "threat_label": {"type": ["boolean", "null"]},
    "windup_start": {"type": ["integer", "null"], "minimum": 0},
    "active_start": {"type": ["integer", "null"], "minimum": 0},
    "impact_frame": {"type": ["integer", "null"], "minimum": 0},
    "recovery_start": {"type": ["integer", "null"], "minimum": 0},
    "recovery_end": {"type": ["integer", "null"], "minimum": 0},
    "impact_evidence": {"enum": ["OBSERVED_CONTACT", "ESTIMATED_COUNTERFACTUAL", "NO_CONTACT", "OCCLUDED", "OUT_OF_CLIP"]},
    "estimated_contact_interval": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}]},
    "dodge_start": {"type": ["integer", "null"], "minimum": 0},
    "dodge_direction": {"enum": ["LEFT", "RIGHT", "FORWARD", "BACK", "NEUTRAL", "UNKNOWN"]},
    "dodge_timing_evidence": {"enum": ["INPUT_LOG", "VISUAL_ONSET", "NOT_OBSERVED"]},
    "direction_space": {"const": "SCREEN"},
    "would_hit_without_dodge": {"enum": ["TRUE", "FALSE", "UNKNOWN"]},
    "roi": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "annotation_status": {"enum": ["proposed", "reviewed", "rejected"]},
    "annotator": {"type": "string"},
    "reviewer": {"type": "string"},
    "reviewed_at": {"type": ["string", "null"]},
    "revision": {"type": "integer", "minimum": 0},
    "example_only": {"type": "boolean"},
    "notes": {"type": "string"}
  },
  "allOf": [
    {"if": {"properties": {"annotation_status": {"const": "reviewed"}}}, "then": {"required": ["reviewer", "reviewed_at"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"impact_evidence": {"const": "OBSERVED_CONTACT"}}}, "then": {"required": ["impact_frame", "active_start"], "properties": {"impact_frame": {"type": "integer"}, "active_start": {"type": "integer"}}}, "else": {"properties": {"impact_frame": {"type": "null"}}}}
  ]
}
